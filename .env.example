# Copy this file to .env and fill in the keys you want to use.
# The workflow stops at image generation; no video API key is required.

# Vision model: reads each shoe multiview image and creates product locks.
VISION_MODEL_PROVIDER=openai_compatible
VISION_MODEL=gpt-5.4-mini
VISION_API_URL=https://api.openai.com/v1/chat/completions
VISION_MODEL_API_KEY=replace_me

# Text model: localization, selling points, script and image prompts.
TEXT_MODEL_PROVIDER=openai_compatible
TEXT_MODEL=deepseek-chat
TEXT_API_URL=https://api.deepseek.com/chat/completions
TEXT_MODEL_API_KEY=replace_me

# Image model: storyboard boards and clean video keyframes.
# Set IMAGE_MODEL_PROVIDER=manual to only write prompt files.
IMAGE_MODEL_PROVIDER=generic
IMAGE_MODEL=img2
IMAGE_API_URL=
IMAGE_MODEL_API_KEY=replace_me

# Defaults.
DEFAULT_ASPECT_RATIO=9:16
STORYBOARD_ASPECT_RATIO=16:9
KEYFRAME_ASPECT_RATIO=9:16
