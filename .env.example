# Copy this file to .env and fill in the keys you want to use.
# The workflow stops at image generation; no video API key is required.

# Vision model: Right Code key used only for shoe-image analysis.
VISION_MODEL_PROVIDER=right_codes
VISION_MODEL=gemini-2.5-flash
VISION_API_URL=https://right.codes/gemini
VISION_MODEL_API_KEY=replace_me
VISION_TIMEOUT_MS=120000

# Text model: localization, selling points, and the editable 20-second script.
TEXT_MODEL_PROVIDER=deepseek
TEXT_MODEL=deepseek-v4-pro
TEXT_API_URL=https://api.deepseek.com/chat/completions
TEXT_MODEL_API_KEY=replace_me
TEXT_TIMEOUT_MS=180000

# Image model: independently configured Right Code key for image generation.
# Set IMAGE_MODEL_PROVIDER=manual to only create prompt packages.
IMAGE_MODEL_PROVIDER=right_codes
IMAGE_MODEL=gpt-image-2
IMAGE_API_URL=https://www.right.codes/draw/v1/images/generations
IMAGE_MODEL_API_KEY=replace_me
IMAGE_TIMEOUT_MS=300000
STORYBOARD_IMAGE_SIZE=1536x1024
