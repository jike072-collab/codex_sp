{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jike072-collab/codex_sp/schemas/studio-project.schema.json",
  "title": "Shoe Ad Studio Project",
  "type": "object",
  "required": [
    "id",
    "name",
    "targetCountry",
    "audience",
    "status",
    "createdAt",
    "updatedAt",
    "assets"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "targetCountry": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "assets",
        "analyzing",
        "review",
        "market",
        "script",
        "visual",
        "export"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "storedName", "mimeType", "hash", "size", "url"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string", "minLength": 1 },
          "storedName": { "type": "string", "minLength": 1 },
          "mimeType": { "enum": ["image/jpeg", "image/png", "image/webp"] },
          "hash": { "type": "string", "minLength": 1 },
          "size": { "type": "integer", "minimum": 1 },
          "url": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "visionAnalysis": {
      "type": ["object", "null"]
    },
    "reviewConfirmedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "marketBrief": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/marketBrief" }
      ]
    },
    "marketConfirmedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "planningPackage": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/planningPackage" }
      ]
    },
    "scriptGeneratedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "scriptConfirmedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "imagePackage": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/imagePackage" }
      ]
    },
    "manualOmniPackages": {
      "type": "array",
      "items": false,
      "maxItems": 0
    },
    "visualGeneratedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "visualGenerationFailure": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["code", "message", "failedAt", "possiblyBilled"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 },
            "failedAt": {
              "type": "string",
              "format": "date-time"
            },
            "possiblyBilled": { "type": "boolean" },
            "retryable": { "type": "boolean" },
            "providerStatus": { "type": "integer" }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "$defs": {
    "marketBrief": {
      "type": "object",
      "required": [
        "targetCountry",
        "audience",
        "creativeTheme",
        "coreMessage",
        "tone",
        "outputAspectRatio"
      ],
      "properties": {
        "targetCountry": { "type": "string", "minLength": 1 },
        "audience": { "type": "string", "minLength": 1 },
        "creativeTheme": {
          "enum": [
            "city-motion",
            "daily-comfort",
            "performance-detail",
            "street-style"
          ]
        },
        "coreMessage": { "type": "string", "minLength": 1 },
        "tone": {
          "enum": ["energetic", "clean", "warm", "bold"]
        },
        "outputAspectRatio": {
          "enum": ["9:16", "16:9", "1:1", "4:5", "3:4", "2:3"]
        }
      },
      "additionalProperties": false
    },
    "shot": {
      "type": "object",
      "required": [
        "start_sec",
        "end_sec",
        "visual",
        "action",
        "camera",
        "selling_point",
        "localized_caption_or_vo",
        "sound",
        "transition"
      ],
      "properties": {
        "start_sec": { "type": "number" },
        "end_sec": { "type": "number" },
        "visual": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 },
        "camera": { "type": "string", "minLength": 1 },
        "selling_point": { "type": "string", "minLength": 1 },
        "localized_caption_or_vo": { "type": "string", "minLength": 1 },
        "sound": { "type": "string", "minLength": 1 },
        "transition": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "scriptSegment": {
      "type": "object",
      "required": ["segment_id", "theme", "duration_sec", "shots"],
      "properties": {
        "segment_id": { "enum": ["0-10s", "10-20s"] },
        "theme": { "type": "string", "minLength": 1 },
        "duration_sec": { "const": 10 },
        "shots": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/shot" }
        }
      },
      "additionalProperties": false
    },
    "planningPackage": {
      "type": "object",
      "required": [
        "mode",
        "locale_profile",
        "product_lock_manifest",
        "selling_points",
        "creative_direction",
        "script_20s",
        "localized_copy",
        "confirmation_summary"
      ],
      "properties": {
        "mode": { "type": "string" },
        "locale_profile": { "type": "object" },
        "product_lock_manifest": { "type": "object" },
        "selling_points": { "type": "array" },
        "creative_direction": { "type": "object" },
        "script_20s": {
          "type": "object",
          "required": [
            "total_duration_sec",
            "segment_a_0_10s",
            "segment_b_10_20s"
          ],
          "properties": {
            "total_duration_sec": { "const": 20 },
            "segment_a_0_10s": { "$ref": "#/$defs/scriptSegment" },
            "segment_b_10_20s": { "$ref": "#/$defs/scriptSegment" }
          }
        },
        "localized_copy": { "type": "object" },
        "confirmation_summary": { "type": "object" }
      }
    },
    "imageGenerationItem": {
      "type": "object",
      "required": [
        "asset_id",
        "segment_id",
        "type",
        "aspect_ratio",
        "prompt",
        "negative_prompt",
        "reference_policy"
      ],
      "properties": {
        "asset_id": { "type": "string", "minLength": 1 },
        "segment_id": { "enum": ["0-10s", "10-20s"] },
        "type": { "const": "storyboard_board" },
        "aspect_ratio": { "enum": ["9:16", "16:9", "1:1", "4:5", "3:4", "2:3"] },
        "storyboard_sheet": {
          "type": "object",
          "required": ["layout", "aspect_ratio", "default_size"],
          "properties": {
            "layout": { "const": "storyboard_sheet" },
            "aspect_ratio": { "type": "string", "minLength": 1 },
            "default_size": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "prompt": { "type": "string", "minLength": 1 },
        "negative_prompt": { "type": "string", "minLength": 1 },
        "reference_policy": { "type": "string", "minLength": 1 },
        "status": { "enum": ["waiting", "running", "done", "failed"] },
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 },
            "retryable": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "script_copy": { "type": "string" },
        "generated_image": {
          "type": "object",
          "required": ["provider", "model", "url", "size"],
          "properties": {
            "provider": { "type": "string", "minLength": 1 },
            "model": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "minLength": 1 },
            "size": { "type": "string", "minLength": 1 },
            "referenceMode": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      }
    },
    "imagePackage": {
      "type": "object",
      "required": [
        "mode",
        "storyboard_plan",
        "image_generation",
        "qc_checklist"
      ],
      "properties": {
        "mode": { "type": "string" },
        "storyboard_plan": { "type": "object" },
        "image_generation": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/imageGenerationItem" }
        },
        "qc_checklist": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "additionalProperties": true
}
